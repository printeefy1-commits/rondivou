HOST=127.0.0.1
PORT=3000
# Required for remote access; use HTTPS through your hosting platform.
PUBLIC_URL=http://localhost:3000
ADMIN_PASSWORD=
COOKIE_SECURE=false
DATABASE_PATH=.data/rondivou.sqlite
# A single numeric Telegram account/chat ID, never a group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_WEBHOOK_SECRET=
# One edited card per conversation; full text history remains on the website.
TELEGRAM_COMPACT=true
# Facebook Page + linked Instagram professional account, with approved messaging permissions.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ID=
META_GRAPH_VERSION=v23.0
# OpenAI-compatible FreeLLMAPI gateway; HTTPS reachable from the app container.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=auto
